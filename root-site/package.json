{
  "name": "thomasriley-ca",
  "version": "2.0.0",
  "description": "Main frontend for thomasriley.ca",
  "author": "Tom Riley <mail@thomasriley.ca>",
  "main": "server.js",
  "scripts": {
    "format": "npx prettier --write .",
    "lint": "npx eslint .",
    "compile": "npx tsc -b",
    "compile-debug": "npx tsc --sourcemap",
    "test": "npx tsc -b && node --test \"src/**/*.test.cjs\"",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "dotenv": "^17.4.2",
    "ejs": "^3.1.6",
    "express": "^4.16.1",
    "http-proxy-middleware": "^3.0.7",
    "marked": "^4.0.12",
    "neverthrow": "^4.3.1",
    "node-cache": "^5.1.2",
    "yargs": "^18.1.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.6",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.13",
    "@types/marked": "^4.0.2",
    "@types/yargs": "^17.0.35",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.4.0",
    "eslint-plugin-ejs": "^0.0.2",
    "eslint-plugin-neverthrow": "^1.1.4",
    "lint-staged": "^17.5.1",
    "prettier": "^2.5.1",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  }
}
